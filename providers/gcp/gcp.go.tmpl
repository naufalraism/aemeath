//go:build ignore

package gcp

import (
	"context"
	"crypto/rand"
	"encoding/hex"
	"fmt"
	"io"
	"path"
	"time"

	"cloud.google.com/go/storage"
)

type GCSStorage struct {
	Client *storage.Client
	Bucket string
	Ctx    context.Context
}

func New(bucket string) (*GCSStorage, error) {
	ctx := context.Background()
	client, err := storage.NewClient(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to load GCP config: %w", err)
	}
	return &GCSStorage{Client: client, Bucket: bucket, Ctx: ctx}, nil
}

func (s *GCSStorage) Save(filename string, src io.Reader) (string, error) {
	var rnd [8]byte
	if _, err := rand.Read(rnd[:]); err != nil {
		return "", err
	}
	key := fmt.Sprintf("%d_%s_%s", time.Now().Unix(), hex.EncodeToString(rnd[:]), path.Base(filename))

	writer := s.Client.Bucket(s.Bucket).Object(key).NewWriter(s.Ctx)
	if _, err := io.Copy(writer, src); err != nil {
		_ = writer.Close()
		return "", err
	}
	// The upload is only committed when Close succeeds, so its error matters.
	if err := writer.Close(); err != nil {
		return "", err
	}
	return key, nil
}

func (s *GCSStorage) Delete(filename string) error {
	return s.Client.Bucket(s.Bucket).Object(filename).Delete(s.Ctx)
}
