# Copy to .env and fill in. Loaded by examples/basic.
PORT=3000

# Secret used to verify JWTs (examples/gen_token signs with the same value).
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Google OAuth2 (optional, for the /auth/google/* demo routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/auth/google/callback
