# Copy to .env and fill in. Loaded by examples/basic.
PORT=3000

# Secret used to verify JWTs (examples/gen_token signs with the same value).
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# development: session cookies over plain http (localhost only).
APP_ENV=development

# Google login through OpenID Connect (optional, /auth/google/* routes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# GitHub login through OAuth2 (optional, /auth/github/* routes).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback
