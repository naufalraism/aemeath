# Ignore generated output
client.ts
coverage.out
*.test

# Ignore compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Ignore Node modules (VitePress)
node_modules/
docs/.vitepress/dist
docs/.vitepress/cache

# Ignore OS/IDE files
.DS_Store
.vscode/
.idea/
# TypeScript check output
examples/tscheck/generated/
node_modules/
